 "legendas": [
  {
   "de": 0,
   "ate": 10,
   "a": 1.6,
   "b": 5.44,
   "texto": "Todo projeto de mudança tem uma parte que cabe no slide:"
  },
  {
   "de": 11,
   "ate": 16,
   "a": 5.48,
   "b": 8.4,
   "texto": "o prazo, o sistema, o treinamento."
  },
  {
   "de": 17,
   "ate": 21,
   "a": 9.187,
   "b": 10.627,
   "texto": "É a ponta do iceberg."
  },
  {
   "de": 22,
   "ate": 28,
   "a": 11.227,
   "b": 14.387,
   "texto": "E muita reunião termina aqui, na superfície."
  },
  {
   "de": 29,
   "ate": 39,
   "a": 15.612,
   "b": 19.132,
   "texto": "Só que a mudança de verdade acontece abaixo da linha d'água."
  },
  {
   "de": 40,
   "ate": 44,
   "a": 20.687,
   "b": 22.527,
   "texto": "No que cada pessoa entende."
  },
  {
   "de": 45,
   "ate": 48,
   "a": 23.227,
   "b": 24.347,
   "texto": "No que ela acredita."
  },
  {
   "de": 49,
   "ate": 54,
   "a": 25.167,
   "b": 26.607,
   "texto": "No que tem medo de perder."
  },
  {
   "de": 55,
   "ate": 58,
   "a": 27.372,
   "b": 28.812,
   "texto": "Nos hábitos de anos."
  },
  {
   "de": 59,
   "ate": 63,
   "a": 29.547,
   "b": 31.227,
   "texto": "Na confiança em quem lidera."
  },
  {
   "de": 64,
   "ate": 71,
   "a": 32.688,
   "b": 35.568,
   "texto": "É nesse gelo invisível que os projetos batem."
  },
  {
   "de": 72,
   "ate": 76,
   "a": 36.348,
   "b": 37.708,
   "texto": "O sistema entra no ar,"
  },
  {
   "de": 77,
   "ate": 83,
   "a": 37.948,
   "b": 39.788,
   "texto": "e as pessoas voltam para a planilha."
  },
  {
   "de": 84,
   "ate": 88,
   "a": 41.381,
   "b": 43.621,
   "texto": "Gestão da mudança é mergulhar."
  },
  {
   "de": 89,
   "ate": 94,
   "a": 44.533,
   "b": 46.853,
   "texto": "Primeiro, a gente mapeia o gelo:"
  },
  {
   "de": 95,
   "ate": 97,
   "a": 46.893,
   "b": 48.053,
   "texto": "quem é impactado,"
  },
  {
   "de": 98,
   "ate": 103,
   "a": 48.093,
   "b": 49.733,
   "texto": "o que muda para cada um,"
  },
  {
   "de": 104,
   "ate": 107,
   "a": 49.813,
   "b": 51.333,
   "texto": "onde está a resistência."
  },
  {
   "de": 108,
   "ate": 113,
   "a": 52.639,
   "b": 55.199,
   "texto": "Depois, quebra esse gelo em partes."
  },
  {
   "de": 114,
   "ate": 117,
   "a": 56.48,
   "b": 58.56,
   "texto": "Com sentido: o porquê,"
  },
  {
   "de": 118,
   "ate": 122,
   "a": 58.64,
   "b": 60.0,
   "texto": "na voz de quem lidera."
  },
  {
   "de": 123,
   "ate": 124,
   "a": 60.874,
   "b": 61.994,
   "texto": "Com prática:"
  },
  {
   "de": 125,
   "ate": 130,
   "a": 62.074,
   "b": 64.394,
   "texto": "as pessoas aprendendo no trabalho real."
  },
  {
   "de": 131,
   "ate": 133,
   "a": 65.248,
   "b": 66.448,
   "texto": "E com medida:"
  },
  {
   "de": 134,
   "ate": 140,
   "a": 66.528,
   "b": 69.448,
   "texto": "o uso de verdade, semana a semana."
  },
  {
   "de": 141,
   "ate": 143,
   "a": 70.881,
   "b": 72.241,
   "texto": "Pedaço por pedaço,"
  },
  {
   "de": 144,
   "ate": 150,
   "a": 72.401,
   "b": 74.641,
   "texto": "o que travava o projeto vira caminho."
  },
  {
   "de": 151,
   "ate": 157,
   "a": 75.622,
   "b": 78.262,
   "texto": "E a adoção deixa de ser promessa:"
  },
  {
   "de": 158,
   "ate": 159,
   "a": 78.302,
   "b": 79.222,
   "texto": "vira rotina."
  },
  {
   "de": 160,
   "ate": 167,
   "a": 80.776,
   "b": 83.896,
   "texto": "Isso é gestão da mudança além do raso."
  }
 ],
