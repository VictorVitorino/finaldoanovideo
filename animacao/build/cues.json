 "subs": [
  {
   "de": 9.6,
   "ate": 12.5,
   "quem": "Narrador",
   "texto": "Todo mundo que já viveu um projeto de ERP conhece esse filme."
  },
  {
   "de": 12.5,
   "ate": 15.5,
   "quem": "Narrador",
   "texto": "A diferença é quem você chama quando ele começa a dar errado."
  },
  {
   "de": 16.1,
   "ate": 19.3,
   "quem": "Narrador",
   "texto": "A nossa começou com um projeto. E não parou mais de crescer."
  },
  {
   "de": 19.6,
   "ate": 23.4,
   "quem": "Narrador",
   "texto": "De um lado, a TOTVS: a maior empresa de tecnologia do Brasil."
  },
  {
   "de": 23.4,
   "ate": 27.5,
   "quem": "Narrador",
   "texto": "Do outro, a A&M Performance: núcleo de excelência em performance da Alvarez & Marsal."
  },
  {
   "de": 27.8,
   "ate": 31,
   "quem": "Narrador",
   "texto": "Um time de especialistas com mentalidade fazedora e adaptável."
  },
  {
   "de": 31,
   "ate": 34.3,
   "quem": "Narrador",
   "texto": "Executivos que já viveram desafios reais. Gente que entende do jogo."
  },
  {
   "de": 37.5,
   "ate": 40.1,
   "quem": "Narrador",
   "texto": "Tudo começou na Unimed Brasil. Nosso projeto pioneiro."
  },
  {
   "de": 40.5,
   "ate": 43.8,
   "quem": "Narrador",
   "texto": "Tudo começou na maior rede de assistência médica do Brasil."
  },
  {
   "de": 46.5,
   "ate": 49.8,
   "quem": "Narrador",
   "texto": "Depois veio a FUNED, referência em vacinas, medicamentos e biotecnologia."
  },
  {
   "de": 52.5,
   "ate": 55.8,
   "quem": "Narrador",
   "texto": "Na CAOA, acelerando uma montadora."
  },
  {
   "de": 58.5,
   "ate": 61.8,
   "quem": "Narrador",
   "texto": "E a parceria cruzou fronteiras: John Deere, na Argentina."
  },
  {
   "de": 64.5,
   "ate": 67.8,
   "quem": "Narrador",
   "texto": "Na Hughes, a parceria chegou ao espaço."
  },
  {
   "de": 70.5,
   "ate": 73.8,
   "quem": "Narrador",
   "texto": "E na Libercon, construindo junto. Literalmente."
  },
  {
   "de": 81.4,
   "ate": 83.9,
   "quem": "Narrador",
   "texto": "Projeto após projeto, o aprendizado vira método."
  },
  {
   "de": 83.9,
   "ate": 86.5,
   "quem": "Narrador",
   "texto": "O método vira padrão. E o padrão gera previsibilidade."
  },
  {
   "de": 99.4,
   "ate": 103.1,
   "quem": "Narrador",
   "texto": "Com o apoio do Delivery Center, os entregáveis viraram cockpits de dashboards para o cliente."
  },
  {
   "de": 103.4,
   "ate": 105.3,
   "quem": "Narrador",
   "texto": "E quando a gente diz resultado no P&L…"
  },
  {
   "de": 105.4,
   "ate": 107.1,
   "quem": "Narrador",
   "texto": "…é no P&L de todo mundo."
  },
  {
   "de": 112.1,
   "ate": 114.3,
   "quem": "Narrador",
   "texto": "Uma parceria que não só entrega valor para o cliente."
  },
  {
   "de": 114.3,
   "ate": 116.1,
   "quem": "Narrador",
   "texto": "Ela também cresce o nosso negócio."
  },
  {
   "de": 119.6,
   "ate": 120.4,
   "quem": "Giovanna",
   "texto": "Paladini!"
  },
  {
   "de": 121.1,
   "ate": 122.7,
   "quem": "Giovanna",
   "texto": "A TOTVS pagou a nota?"
  },
  {
   "de": 122.9,
   "ate": 123.8,
   "quem": "Paladini",
   "texto": "Pagou."
  },
  {
   "de": 125.1,
   "ate": 127.3,
   "quem": "Antonialli",
   "texto": "Vamos precisar antecipar algumas notas para o FY26."
  },
  {
   "de": 127.4,
   "ate": 128.5,
   "quem": "Antonialli",
   "texto": "Fala com a TOTVS."
  },
  {
   "de": 130.6,
   "ate": 132.7,
   "quem": "Giovanna e Bruno",
   "texto": "Antecipamos as NFs para esse ano fiscal!"
  },
  {
   "de": 132.9,
   "ate": 134.7,
   "quem": "Antonialli",
   "texto": "Agora é Operação Collection Zero Defect."
  },
  {
   "de": 141.9,
   "ate": 145.1,
   "quem": "Antonialli",
   "texto": "Começamos com um projeto na Unimed. Hoje são seis, em dois países,"
  },
  {
   "de": 145.1,
   "ate": 147.3,
   "quem": "Antonialli",
   "texto": "e R$ 7 milhões só neste ano fiscal."
  },
  {
   "de": 147.5,
   "ate": 150.8,
   "quem": "Antonialli",
   "texto": "Isso não é sorte. É método e confiança."
  },
  {
   "de": 151.1,
   "ate": 152.9,
   "quem": "Narrador",
   "texto": "Um projeto que gera projetos."
  },
  {
   "de": 152.9,
   "ate": 155.6,
   "quem": "Narrador",
   "texto": "E mais R$ [X] milhões já a caminho no próximo ano fiscal."
  },
  {
   "de": 163.7,
   "ate": 164.8,
   "quem": "Giovanna",
   "texto": "Gente…"
  },
  {
   "de": 165.4,
   "ate": 166.7,
   "quem": "Giovanna",
   "texto": "Mas pagou a NF?"
  }
 ],
